[Unit]
Description=NetworkLimiter per-process bandwidth daemon
Documentation=https://github.com/Persie0/networklimiter
After=local-fs.target
ConditionPathExists=/sys/fs/cgroup/cgroup.controllers

[Service]
Type=simple
ExecStart=/usr/bin/networklimiter-daemon
Restart=on-failure
RestartSec=3
RuntimeDirectory=networklimiter
RuntimeDirectoryMode=0755
StateDirectory=networklimiter
StateDirectoryMode=0700
UMask=0077
ProtectHome=true
ProtectSystem=full
PrivateTmp=true
# BPF/cgroup operations deliberately require system privileges.
# Do not enable PrivateUsers or capability restrictions without testing.

[Install]
WantedBy=multi-user.target
